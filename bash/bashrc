# -----------------------------------------------------------------------------
# Bash config
# -----------------------------------------------------------------------------

# Return if not running interactively
[ -z "$PS1" ] && return

# TODO Is this necessary?
# source /etc/profile >/dev/null

# Load shared configs
source "$HOME/.ljc/bash/xdg.bash"
source "$HOME/.ljc/bash/env.bash"
source "$HOME/.ljc/bash/functions.bash"
source "$HOME/.ljc/bash/prompt.bash"

# Load platform-specific configs
case "$(uname -s)" in
    Darwin)
        source "$HOME/.ljc/bash/platform_macos.bash"
        ;;
    FreeBSD)
        source "$HOME/.ljc/bash/platform_bsd.bash"
        ;;
    *)
        source "$HOME/.ljc/bash/platform_linux.bash"
        ;;
esac
