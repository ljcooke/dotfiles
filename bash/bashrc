# -----------------------------------------------------------------------------
# Bash config
# -----------------------------------------------------------------------------

# Return if not running interactively
[ -z "$PS1" ] && return

# TODO Is this necessary?
# source /etc/profile >/dev/null

dotljc="$HOME"/.local/opt/dotljc

# Load shared configs
source "$dotljc"/bash/xdg.bash
source "$dotljc"/bash/env.bash
source "$dotljc"/bash/functions.bash
source "$dotljc"/bash/prompt.bash

# Load platform-specific configs
case "$(uname -s)" in
    Darwin)
        source "$dotljc"/bash/platform_macos.bash
        ;;
    FreeBSD)
        source "$dotljc"/bash/platform_bsd.bash
        ;;
    *)
        source "$dotljc"/bash/platform_linux.bash
        ;;
esac

unset dotljc
